# ============================================================
#  Konfigurasi discord-keep-online (Node.js)
#  Copy file ini jadi ".env" lalu isi sesuai kebutuhan.
#     cp .env.example .env
# ============================================================

# ---------- WAJIB ----------
# Token akun Discord kamu (user token, BUKAN bot token).
DISCORD_TOKEN=

# ---------- STATUS DASAR ----------
# online | idle | dnd | invisible
# Nilai ini jadi status awal; setelah READY VPS mengikuti status dari sesi app Discord lain.
STATUS=dnd

# ---------- TERLIHAT DARI PERANGKAT APA ----------
# Indikator di profil Discord: PC/laptop (ikon komputer) atau HP (ikon hp).
#   macos   = MacBook / macOS  (desktop, Apple)      <- default
#   windows = Windows (PC/laptop)
#   linux   = Linux (PC/laptop)
#   web     = Chrome di macOS (ikon browser)
#   android = Android (HP)
#   ios     = iPhone / iPad (HP)
# Alias yang diterima: pc, laptop, mac, macbook, apple, hp, phone, browser, dll.
DEVICE=macos

# ---------- ROBLOX "PLAYING" ----------
# Biar aktivitas "Playing Roblox" kelihatan di Discord walaupun kamu main
# Roblox dari HP (Discord mobile memang tidak bisa mendeteksi game).
#   manual = aktivitas tampil terus selama script jalan (tanpa kredensial)
#   auto   = mengikuti game yang benar-benar kamu mainkan (butuh cookie + user id)
ROBLOX_ENABLED=false
ROBLOX_MODE=manual

# Nama yang tampil: "Playing <ROBLOX_NAME>"
ROBLOX_NAME=ROBLOX

# (manual) baris kedua di bawah nama — mis. nama game.
# Kosongkan kalau tidak mau ada baris kedua.
ROBLOX_GAME=

# (auto) WAJIB: user ID Roblox — angka di URL profilmu
# Contoh: roblox.com/users/8865678208/profile  ->  8865678208
# Bisa juga diambil otomatis dari koneksi Roblox di Discord (lihat README).
ROBLOX_USER_ID=

# (auto) OPSIONAL: cookie .ROBLOSECURITY. Tidak perlu diisi untuk pemakaian
# normal — presence + nama game tetap terbaca tanpa cookie.
# Isi hanya kalau deteksi gagal terus. Cookie = kunci login akun, JANGAN dibagikan!
ROBLOX_COOKIE=

# (auto) Jendela "anti-kedip" (menit): aktivitas tetap tampil sekian menit
# setelah terakhir terlihat main, supaya tidak berkedip saat ganti game/loading.
# 0 (default) = langsung hilang begitu keluar dari Roblox.
ROBLOX_STICKY_MIN=0

# Nama game tampil di baris kedua?
#   true  = tampil nama game (mis. "The Hunt: Roblox 20") — ada tanda kecil "Rich Presence"
#   false = hanya "Playing ROBLOX" + timer — tampilannya persis seperti deteksi Roblox asli
ROBLOX_SHOW_GAME=true

# (auto) Timer "Playing for ..." TIDAK direset kalau kamu cuma sempat keluar
# sebentar/ganti game dalam jendela ini (menit). 0 = reset tiap berhenti.
ROBLOX_TIMER_GRACE_MIN=10

# (auto) seberapa sering presence Roblox dicek (detik, minimal 15)
ROBLOX_POLL_SEC=15

# ID aplikasi "Roblox" resmi di Discord -> supaya logo Roblox yang tampil benar
# (bukan gambar rusak/kosong). Kosongkan kalau tidak mau logo.
ROBLOX_APP_ID=363445589247131668

# ---------- "PURA-PURA MAIN PS5" (atau konsol lain) ----------
# Aktivitas Discord punya field `platform` (ps5 / ps4 / xbox / desktop / ...).
# Kalau diisi ps5, profilmu tampil seperti orang yang benar-benar main di PS5.
#
# ⚠️ Ini hanya TAMPILAN di Discord. Trofi/quest yang dicek Sony di server
#    mereka tidak terpengaruh (mereka tetap tahu kamu tidak online di konsol).
# ⚠️ Kalau PS5_ENABLED=true, aktivitas Roblox otomatis dimatikan (digantikan).
PS5_ENABLED=false

# Nama game yang tampil: "Playing <PS5_GAME>"
# 401 game sudah terdaftar — semua sudah diverifikasi punya IKON RESMI di Discord:
#   Fortnite, GTA V, Minecraft, Genshin Impact, VALORANT, Rocket League,
#   Destiny 2, Apex Legends, EA Sports FC 25, Elden Ring, God of War,
#   Spider-Man, The Last of Us, Horizon Zero Dawn, Gran Turismo,
#   Ghost of Tsushima, Bloodborne, Astro Bot, Tekken 8, Fall Guys,
#   Stumble Guys, Honkai: Star Rail, PUBG, Warframe, The Sims 4, dll.
PS5_GAME=Fortnite

# ─── DASHBOARD PS5 (panel on/off + pilih game) ───────────────────────────────
# Nempel di proses yang sama: TIDAK ada proses/port/RAM tambahan.
DASH_ENABLED=true
DASH_PORT=23304
DASH_HOST=0.0.0.0
# Kunci akses dashboard. Kosongkan = siapa pun yang tahu alamatnya bisa buka.
# Ganti dengan kata rahasiamu sendiri, lalu buka: http://<host>:<port>/?k=KUNCI
DASH_KEY=CHANGE_ME_TO_A_UNIQUE_SECRET

# Port tambahan (opsional, dipisah koma). Isi kalau hosting memberi alamat lewat
# subdomain dan meneruskannya ke port tertentu, mis: # ─── PENJALAN QUEST ──────────────────────────────────────────────────────────
# QUEST_AUTO_START=true  -> begitu bot menyala, semua quest yang bisa dikerjakan
#                           langsung dikerjakan sendiri (klaim hadiah tetap manual).
# QUEST_BEAT_SEC=20      -> jeda heartbeat quest "main game" (klien resmi ±20 detik).
QUEST_AUTO_START=false
# OTOMATIS TANPA TOMBOL: bot memeriksa sendiri tiap QUEST_OTOMATIS_MENIT menit —
# begitu ada quest yang bisa dikerjakan (dari negara mana pun, atau dari ID),
# langsung dikerjakan dan ditunggu sampai selesai. Tidak perlu menekan apa pun.
QUEST_OTOMATIS=true
# tiap berapa menit bot memeriksa & mengerjakan sendiri (1 = terasa instan)
QUEST_OTOMATIS_MENIT=1
# Token Discord KHUSUS quest (opsional). Kosong = pakai DISCORD_TOKEN.
# Biasanya tidak perlu diisi dari sini — ada kartu "Token quest" di dashboard
# (halaman QUEST AUTO) yang bisa mengganti & menghapus token ini.
# Token ini TIDAK dipakai untuk presence/status, PS5, Roblox, atau Spotify.
QUEST_TOKEN=
QUEST_BEAT_SEC=20
# QUEST_UBAH_PRESENCE=true  -> biarkan penjalan quest mengganti presence ke game quest
#                              (perilaku lama). Default false: status profil dibiarkan
#                              apa adanya — quest tetap selesai dari heartbeat saja.
QUEST_UBAH_PRESENCE=false

DASH_PORT_EXTRA=

# ─── TUNNEL KELUAR (biar dashboard bisa dibuka tanpa alamat/port publik) ─────
# Bot membuka tunnel Cloudflare ke dashboard-nya sendiri, lalu URL-nya dilaporkan
# ke satu halaman tetap (mis. di Vercel) supaya cukup bookmark satu alamat.
TUNNEL_ENABLED=true
TUNNEL_DIR=
TUNNEL_LAPOR_URL=
TUNNEL_LAPOR_SECRET=

# Quest yang layak diterima & dikerjakan otomatis oleh QUEST_OTOMATIS di atas.
# Tidak ada tombol "kerjakan semua"; klaim hadiah tetap manual di aplikasi Discord.

# (opsional) ID aplikasi Discord — kosongkan saja, biasanya sudah otomatis.
PS5_APP_ID=

# Nama yang tampil di Discord:
#   true  (default) = pakai nama RESMI versi Discord (mis. "Marvel’s Spider-Man Remastered")
#   false            = pakai nama yang kamu tulis apa adanya
PS5_OFFICIAL_NAME=true

# (opsional) baris kedua di bawah nama game
PS5_DETAILS=

# Platform yang ditampilkan: ps5 | ps4 | xbox | desktop | ios | android
PS5_PLATFORM=ps5

# Tampilkan timer "Playing for ..." ? true / false
PS5_TIMER=true

# ---------- SPOTIFY "LISTENING" ----------
# true = tampilkan lagu Spotify yang sedang diputar di profil Discord.
ENABLE_SPOTIFY=true

# (Opsional) tempel access token Spotify manual. Kosongkan saja,
# script akan mengambil token otomatis lewat Discord API.
# SPOTIFY_ACCESS_TOKEN=

# ---------- STATUS PROFIL YANG GA HILANG ----------
# Aktifkan penjaga status (disimpan permanen di server Discord,
# jadi tetap ada walau aplikasi Discord ditutup / HP restart).
CUSTOM_STATUS_ENABLED=true

# Kosongkan = "mode kunci": script mengambil custom status yang
# sedang kamu pakai di aplikasi Discord, lalu menguncinya supaya
# tidak pernah hilang / tidak kedaluwarsa.
CUSTOM_STATUS_TEXT=

# Emoji custom status (opsional): emoji unicode (contoh: 🔥)
# atau emoji custom dengan format "nama:id" (contoh: pepe:123456789012345678).
CUSTOM_STATUS_EMOJI=

# Cara menjaga status:
#   keep    = permanen & dikunci. Kamu UBAH status di aplikasi -> status baru itu
#             yang dikunci. Kamu HAPUS status -> tetap terhapus, tidak dipasang ulang.
#   enforce = status dipaksa selalu ada; kalau dihapus/diubah, dipasang ulang.
#   off     = script tidak menyentuh custom status sama sekali.
CUSTOM_STATUS_MODE=keep

# true = paksa custom status supaya TIDAK pernah kedaluwarsa
# (opsi "Clear after: Today" dari aplikasi akan diubah jadi "Don't clear").
CUSTOM_STATUS_NEVER_EXPIRE=true

# Seberapa sering (menit) status dicek & dipasang ulang.
CUSTOM_STATUS_REFRESH_MIN=10

# Sertakan custom status di presence gateway (biar ikut tampil
# ketika aplikasi Discord kamu tutup).
PRESENCE_CUSTOM_STATUS=true

# Simpan pilihan online/idle/dnd supaya ikut permanen di server Discord.
PERSIST_STATUS=true

# ---------- LAIN-LAIN ----------
# Seberapa sering presence dikirim ulang (detik) - biar progress bar akurat.
PRESENCE_REFRESH_SEC=15

# Interval fallback polling Spotify (detik).
SPOTIFY_POLL_SEC=10
# Hapus status lagu lama bila sumber tidak bisa diverifikasi selama ini (detik).
SPOTIFY_STALE_SEC=90

# Level log: debug | info | warn | error
LOG_LEVEL=info

# true = tampilkan pesan mentah dari dealer.spotify.com (buat debug)
DEBUG_DEALER=false

# ============================================================================
#  SCOUT ORB — opt-in country quest scan via Tor
# ============================================================================
# Disabled by default after the account-token/logout audit. Prefer a dedicated
# QUEST_TOKEN; main-token sweeps stay blocked unless SCOUT_TOKEN_UTAMA=izin is explicit.
SCOUT_ENABLED=false
SCOUT_TOKEN_UTAMA=tolak
# Dedicated QUEST_TOKEN may use this interval; main-token mode enforces a 5-minute round cooldown.
SCOUT_INTERVAL_MIN=0
SCOUT_INTERVAL_HATI_HATI=5
SCOUT_JEDA_PUTARAN=0
SCOUT_MULAI_DETIK=35
SCOUT_JEDA_SAAT_ID=30
SCOUT_JEDA_ANTAR_NEGARA=11
SCOUT_BURST_MAKS=10
# With the main token, cautious behavior is capped at 3 countries and at least 8s.
SCOUT_BURST_HATI_HATI=3
SCOUT_JEDA_HATI_HATI=8
SCOUT_AUTO_KERJA=true
# SCOUT_SOCKS_PORT=9190
# SCOUT_CTRL_PORT=9191
